rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================
    // 🔐 CORE AUTHORIZATION HELPERS
    // ========================================================

    // Checks if the user is authenticated with Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Validates that the user belongs to the corporate domain '@2020companies.com'
    function isCompanyEmail() {
      return isAuthenticated() && request.auth.token.email.matches('.*@2020companies\\.com');
    }

    // Resolves if the current user is a registered administrator in the custom claims
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Validates if the logged-in user matches the resource's owner email
    function isOwner(email) {
      return isAuthenticated() && request.auth.token.email == email;
    }

    // ========================================================
    // 🗄️ COLLECTION ACCESS RULES
    // ========================================================

    // 1. User Profiles Collection
    // - Users can only read and write their own profile document.
    // - Admins can read all profiles for review, but cannot write directly (enforces profile ownership).
    match /users/{email} {
      allow read: if isOwner(email) || isAdmin();
      allow write: if isOwner(email) || isAdmin();
    }

    // 2. Administrators Collection
    // - Admins can manage admin membership list.
    // - Authenticated users can read their own admin document specifically during login checks.
    match /admins/{email} {
      allow read: if isAdmin() || isOwner(email);
      allow write: if isAdmin();
    }

    // 3. Device Status Reports
    // - Reps can read, create, and update their own device reports.
    // - Admins can read all reports, but cannot modify rep-created reports (except delete for cleanup).
    match /reports/{reportId} {
      allow create: if (isCompanyEmail() && (!('repEmail' in request.resource.data) || request.resource.data.repEmail == request.auth.token.email)) || isAdmin();
      allow read: if (isAuthenticated() && (!('repEmail' in resource.data) || resource.data.repEmail == request.auth.token.email)) || isAdmin();
      allow update: if (isCompanyEmail() && (!('repEmail' in resource.data) || resource.data.repEmail == request.auth.token.email) && (!('repEmail' in request.resource.data) || request.resource.data.repEmail == request.auth.token.email)) || isAdmin();
      allow delete: if isAdmin();
    }

    // 4. Device Health Logs (Audit Trail)
    // - Authenticated reps can write logs, but cannot read or modify them (write-only).
    // - Admins can read all logs for analytics and security audits, but cannot modify or delete them.
    match /device_health_logs/{logId} {
      allow create: if (isCompanyEmail() && (!('repEmail' in request.resource.data) || request.resource.data.repEmail == request.auth.token.email)) || isAdmin();
      allow read: if isAdmin();
      allow update, delete: if false; // Immutable audit log
    }

    // 5. Frequently Asked Questions (FAQs)
    // - Publicly readable (unauthenticated access permitted).
    // - Only administrators can create, update, or delete FAQ articles.
    match /faqs/{faqId} {
      allow read: if true; // Public access
      allow write: if isAdmin(); // Admin-only management
    }

    // 6. Credential Reset Requests (Reset Requests support)
    // - Reps can create requests (write-only).
    // - Admins can read and delete requests to process them. No updates allowed.
    match /credential_requests/{requestId} {
      allow create: if (isCompanyEmail() && (!('repEmail' in request.resource.data) || request.resource.data.repEmail == request.auth.token.email)) || isAdmin();
      allow read, delete: if isAdmin();
      allow update: if false; // Immutable requests
    }

    // Support legacy reset_requests naming
    match /reset_requests/{requestId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'date']) 
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('.*@2020companies\\.com');
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // 7. Secure Meta AI Credentials Collection
    // - Representatives can read their own credentials, but cannot write them directly.
    // - Admins manage credentials via bulk-sync Cloud Functions.
    match /credentials/{email} {
      allow read: if isOwner(email) || isAdmin();
      allow write: if isAdmin();
    }

    // 8. View Logs (User analytics)
    match /view_logs/{logId} {
      allow create: if (isAuthenticated() && request.resource.data.userId == request.auth.token.email)
                    || (!isAuthenticated() && (request.resource.data.userId == 'anonymous' || request.resource.data.userId == 'anonymous_admin'));
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // 9. Replacement Requests Collection
    // - Reps can create requests for themselves.
    // - Admins can read, create, and delete requests.
    match /replacement_requests/{reqId} {
      allow create: if (isCompanyEmail() && (!('repEmail' in request.resource.data) || request.resource.data.repEmail == request.auth.token.email)) || isAdmin();
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // 10. Allowlist Collection
    // - Only administrators can read or write allowlist entries.
    match /allowlist/{email} {
      allow read, write: if isAdmin();
    }
  }
}
